datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================
enum UserRole {
  SUPER_ADMIN
  TIM_KERJA
}

enum SpjType {
  PERJADIN
  MAKAN_MINUM
  HONORARIUM
  OPERASIONAL
}

enum RosterRole {
  KEPALA_JALAN
  PENGIKUT
}

enum JenisNaskah {
  SURAT_TUGAS
  SURAT_PERINTAH
  TELAAHAN_STAF
  SURAT_EDARAN_SEKDA
  SURAT_EDARAN_BUPATI
  SURAT_UMUM
  NOTULA
}

enum StatusAgendaAbsensi {
  BERLANGSUNG
  SELESAI
  DIBATALKAN
}

enum StatusKehadiran {
  HADIR
  MEWAKILI
  TIDAK_HADIR
  IZIN
}

// ==========================================
// AUTH & MULTI-TENANT
// ==========================================
model Team {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  users     User[]
  spjs      Spj[]
  pegawais  Pegawai[]
  vendors   VendorPihakKetiga[]
  naskahDinas NaskahDinas[]
  agendaAbsensi AgendaAbsensi[]
  agendaTim   AgendaTim[]
}

model User {
  id           String   @id @default(uuid())
  name         String
  username     String   @unique
  passwordHash String
  role         UserRole @default(TIM_KERJA)

  teamId       String
  team         Team     @relation(fields: [teamId], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  spjsCreated  Spj[]
  subKegiatan  SubKegiatan[]
  naskahDinas  NaskahDinas[]
  agendaAbsensi AgendaAbsensi[]
  agendaTim    AgendaTim[]
}

// ==========================================
// DATABASE MASTER
// ==========================================
model Pegawai {
  id        String   @id @default(uuid())
  nip       String?
  nama      String
  pangkat   String?
  golongan  String?
  jabatan   String
  instansi  String   @default("Sekretariat Daerah Kabupaten Kutai Barat")
  
  // Binding Khusus Eselon & Absensi OPD
  eselon          String?  // misal: "II.b", "III.a"
  kategoriPegawai String?  // misal: "ESELON_2", "ESELON_3", "KECAMATAN", "STAF", "UMUM"
  wajibAbsenOpd   Boolean  @default(false)
  urutanOpd       Int?     @default(0)

  // Status Tim Internal (Hanya muncul di pencarian SPJ & Tata Naskah Dinas)
  timInternal     Boolean  @default(false)

  // Biometrik Wajah
  faceDescriptor  String?   @db.Text
  faceEnrolledAt  DateTime?

  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rosterItems    SpjRosterItem[]
  kehadiranItems KehadiranPeserta[]

  @@unique([nip, teamId])
  @@index([teamId, nama])
  @@index([teamId, wajibAbsenOpd])
  @@index([teamId, timInternal])
  @@index([teamId, instansi])
}

model VendorPihakKetiga {
  id           String   @id @default(uuid())
  namaVendor   String
  namaPemilik  String?
  alamat       String?
  npwp         String?
  npwpd        String?
  rekeningBank String?
  
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  spjMaminDetails SpjMaminDetail[]
}

// ==========================================
// STRUKTUR ANGGARAN & SALDO
// ==========================================
model TahunAnggaran {
  id        String     @id @default(uuid())
  tahun     String     @unique
  
  kegiatan  Kegiatan[]
}

model Kegiatan {
  id              String        @id @default(uuid())
  tahunAnggaranId String
  tahunAnggaran   TahunAnggaran @relation(fields: [tahunAnggaranId], references: [id], onDelete: Cascade)

  kodeKegiatan    String
  judulKegiatan   String
  subKegiatan     SubKegiatan[]
}

model SubKegiatan {
  id         String   @id @default(uuid())
  kegiatanId String
  kegiatan   Kegiatan @relation(fields: [kegiatanId], references: [id], onDelete: Cascade)

  kodeSub    String
  judulSub   String

  rekening   KodeRekening[]
  users      User[]
}

model KodeRekening {
  id            String      @id @default(uuid())
  subKegiatanId String
  subKegiatan   SubKegiatan @relation(fields: [subKegiatanId], references: [id], onDelete: Cascade)

  kodeRekening  String
  judulRekening String

  saldoAwal     BigInt
  sisaSaldo     BigInt

  spjs          Spj[]
}

// ==========================================
// INTI TRANSAKSI SPJ
// ==========================================
model Spj {
  id            String      @id @default(uuid())
  nomorBku      String?     @unique
  tanggalSpj    DateTime    @default(now())
  jenisSpj      SpjType
  perihal       String?     @db.Text // Penjelasan/maksud perjalanan dinas
  tanggalPelaksanaan DateTime?

  // Penghubung ke Sumber Saldo
  kodeRekeningId String
  kodeRekening   KodeRekening @relation(fields: [kodeRekeningId], references: [id])

  // Atribut Kepemilikan (Multi-Tenant)
  teamId        String
  team          Team        @relation(fields: [teamId], references: [id])
  createdById   String
  createdBy     User        @relation(fields: [createdById], references: [id])

  totalPengeluaran BigInt   @default(0)

  // Tautan Dokumen Fisik (Google Drive / Cloud Storage Eksternal)
  driveUrl      String?     // <--- KOLOM BARU DI SINI (Opsional/Wajib sesuai kebijakan)

  // Status Pembayaran
  terbayar      Boolean     @default(false)

  // Meta Dokumen Cetak (JSON Dinamis: Menghemat tabel 1-to-1 untuk narasi dokumen)
  metaDokumen   Json?

  isDeleted     Boolean     @default(false)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Ekstensi Relasi Modular
  pengeluaranDetails SpjPengeluaranDetail[]
  roster             SpjRosterItem[]
  perjadinDetail     SpjPerjadinDetail?
  maminDetail        SpjMaminDetail?
}

model SpjPengeluaranDetail {
  id              String @id @default(uuid())
  spjId           String
  spj             Spj    @relation(fields: [spjId], references: [id], onDelete: Cascade)

  // Ekstensi khusus DOPD Perjadin (menempel ke personel)
  spjRosterItemId String?
  rosterItem      SpjRosterItem? @relation(fields: [spjRosterItemId], references: [id], onDelete: Cascade)
  
  kategori        String? // misal: "UANG HARIAN", "UANG TRANSPORT"
  faktorPengali   Json?   // misal: [{ label: "org", value: 1 }, { label: "hari", value: 3 }]

  uraian          String
  hargaSatuan     BigInt
  qty             Int    @default(1)
  satuan          String @default("Orang")
  total           BigInt
}

// ==========================================
// EXTENSION MODUL SPESIFIK
// ==========================================
model SpjPerjadinDetail {
  id              String   @id @default(uuid())
  spjId           String   @unique
  spj             Spj      @relation(fields: [spjId], references: [id], onDelete: Cascade)

  tempatBerangkat String   @default("Sendawar")
  tempatTujuan    String
  tglBerangkat    DateTime
  tglKembali      DateTime
  lamaPerjalanan  Int
  alatAngkut      String   @default("Darat")
  tingkatPerjadin String?
}

model SpjRosterItem {
  id        String     @id @default(uuid())
  spjId     String
  spj       Spj        @relation(fields: [spjId], references: [id], onDelete: Cascade)

  pegawaiId String
  pegawai   Pegawai    @relation(fields: [pegawaiId], references: [id])

  order     Int        @default(0)
  role      RosterRole @default(PENGIKUT)

  // Snapshot Data
  nama      String
  nip       String?
  jabatan   String
  golongan  String?
  pangkat   String?

  pengeluaranDetails SpjPengeluaranDetail[]
}

model SpjMaminDetail {
  id           String            @id @default(uuid())
  spjId        String            @unique
  spj          Spj               @relation(fields: [spjId], references: [id], onDelete: Cascade)

  vendorId     String
  vendor       VendorPihakKetiga @relation(fields: [vendorId], references: [id])

  namaRapat    String
  jumlahPeserta Int
}

// ==========================================
// TATA NASKAH DINAS
// ==========================================
model NaskahDinas {
  id          String      @id @default(uuid())
  jenisNaskah JenisNaskah
  nomorSurat  String?
  tanggal     DateTime    @default(now())
  perihal     String?     @db.Text
  agenda      String?     @db.Text
  
  // Atribut Kepemilikan (Multi-Tenant)
  teamId      String
  team        Team        @relation(fields: [teamId], references: [id])
  createdById String
  createdBy   User        @relation(fields: [createdById], references: [id])

  // Data spesifik dokumen JSON
  data        Json?

  isDeleted   Boolean     @default(false)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// ==========================================
// ABSENSI PERANGKAT DAERAH (OPD)
// ==========================================
model AgendaAbsensi {
  id              String               @id @default(uuid())
  publicToken     String?              @unique
  namaKegiatan    String
  hari            String?              // misal: "Senin"
  tanggal         DateTime             // Tanggal pelaksanaan kegiatan
  waktu           String?              // misal: "09:00 WITA - Selesai"
  tempat          String
  deskripsi       String?              @db.Text
  targetPeserta   String?              @default("Eselon II.b dan III.a")
  targetKategori  String?              @default("ESELON_2_3") // "ESELON_2", "ESELON_3", "SEMUA_OPD", "KECAMATAN", "CUSTOM"
  
  // Pengaturan Waktu & Status Pengisian Mandiri
  isPublicActive  Boolean              @default(true)
  waktuBukaAbsen  DateTime?            // Waktu mulai form dibuka
  waktuTutupAbsen DateTime?            // Waktu batas form ditutup
  requireLocation Boolean              @default(true) // Wajib GPS
  requirePhoto    Boolean              @default(true) // Wajib Selfie Foto
  allowNonPeserta Boolean              @default(true) // Izinkan peserta di luar daftar mengisi absen

  // Fitur Presensi Pulang (Opsional)
  enableCheckOut   Boolean             @default(false) // Saklar aktifkan presensi pulang
  waktuBukaPulang  DateTime?           // Waktu mulai form presensi pulang dibuka
  waktuTutupPulang DateTime?           // Waktu batas akhir form presensi pulang ditutup

  // Titik Lokasi Kegiatan & Geofencing (Opsional)
  targetLatitude  Float?
  targetLongitude Float?
  radiusMeter     Int?                 @default(100) // Radius batas toleransi kehadiran dalam meter

  status          StatusAgendaAbsensi  @default(BERLANGSUNG)
  driveUrl        String?              // Tautan Google Drive hasil scan absensi/foto
  
  // Penandatangan / PIC Agenda (Opsional)
  picPegawaiId    String?
  picNama         String?
  picNip          String?
  picJabatan      String?

  teamId          String
  team            Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdById     String
  createdBy       User                 @relation(fields: [createdById], references: [id])
  
  isDeleted       Boolean              @default(false)

  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  
  peserta         KehadiranPeserta[]

  @@index([teamId, tanggal])
  @@index([publicToken])
}

model KehadiranPeserta {
  id                String          @id @default(uuid())
  agendaId          String
  agenda            AgendaAbsensi   @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  
  pegawaiId         String?
  pegawai           Pegawai?        @relation(fields: [pegawaiId], references: [id], onDelete: SetNull)
  
  // Snapshot Data Pejabat / OPD
  nama              String
  nip               String?
  jabatan           String
  instansi          String          // Nama Perangkat Daerah
  eselon            String?         // "II.b" | "III.a"
  urutan            Int             @default(0)
  
  // Status dan Keterangan
  status            StatusKehadiran @default(TIDAK_HADIR)
  namaPerwakilan    String?         // Diisi jika status MEWAKILI
  jabatanPerwakilan String?
  keterangan        String?

  // Self Input Publik, Geotag, Foto, dan Waktu (Presensi Datang)
  isSelfInput       Boolean         @default(false)
  waktuInput        DateTime?       // Waktu saat melakukan submit absen datang
  latitude          Float?
  longitude         Float?
  accuracy          Float?          // Akurasi GPS dalam meter
  lokasiText        String?         // Geocoding / string lat,lng
  fotoUrl           String?         // URL foto bukti di Cloudflare R2
  ipAddress         String?
  userAgent         String?

  // Presensi Pulang (Opsional)
  waktuPulang       DateTime?       // Waktu saat melakukan submit absen pulang
  fotoPulangUrl     String?         // URL foto bukti selfie pulang
  latitudePulang    Float?
  longitudePulang   Float?
  accuracyPulang    Float?
  lokasiPulangText  String?
  
  // Audit Biometrik Wajah
  faceScore         Float?          // Skor kemiripan biometrik (0.0 - 1.0)
  faceMatchStatus   String?         // "MATCH" | "MISMATCH" | "ENROLLED" | "PERWAKILAN" | "PESERTA_TAMBAHAN" | "BYPASS"

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([agendaId])
  @@index([instansi])
}

// ==========================================
// AGENDA KEGIATAN TIM
// ==========================================
enum KategoriAgenda {
  RAPAT
  PERJALANAN_DINAS
  SOSIALISASI
  MONITORING_EVALUASI
  ACARA_INTERNAL
  PENGINGAT
  LAINNYA
}

enum StatusAgenda {
  DIRENCANAKAN
  BERLANGSUNG
  SELESAI
  DIBATALKAN
}

model AgendaTim {
  id             String         @id @default(uuid())
  judul          String
  kategori       KategoriAgenda @default(RAPAT)
  tanggalMulai   DateTime
  tanggalSelesai DateTime?
  waktuMulai     String?        // misal "09:00"
  waktuSelesai   String?        // misal "12:00"
  lokasi         String?
  deskripsi      String?        @db.Text
  pic            String?        // Nama PIC / Penanggung Jawab
  status         StatusAgenda   @default(DIRENCANAKAN)

  teamId         String
  team           Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User           @relation(fields: [createdById], references: [id])

  isDeleted      Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([teamId, tanggalMulai])
}

